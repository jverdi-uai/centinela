# Copiar como .env. Nunca versionar secretos.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MOCK_MODE=true
SHADOW_MODE=false
THRESHOLD_REVIEW=0.35
THRESHOLD_BLOCK=0.70
DATABASE_URL=sqlite:///data/centinela.db
TRACE_RETENTION_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_DOCUMENT_MB=10
MAX_PDF_PAGES=5
MODEL_INPUT_USD_PER_MILLION=0.20
MODEL_OUTPUT_USD_PER_MILLION=1.20
EMBEDDING_USD_PER_MILLION=0.02
